pipeline {
  agent any

  options {
    skipDefaultCheckout(false)
    timestamps()
  }

  environment {
    APP_VERSION = "${env.BUILD_TAG ?: "dev"}"
  }

  stages {
    stage('Prepare') {
      steps {
        script {
          echo "Workspace: ${pwd()}"
          echo "Building microservicio-perfiles"
          if (isUnix()) {
            sh "chmod +x gradlew"
          }
        }
      }
    }

    stage('Build') {
      steps {
        script {
          if (isUnix()) {
            sh "./gradlew clean compileJava compileTestJava --no-daemon --stacktrace"
          } else {
            bat ".\\gradlew.bat clean compileJava compileTestJava --no-daemon --stacktrace"
          }
        }
      }
    }

    stage('Unit Tests') {
      steps {
        script {
          if (isUnix()) {
            sh "./gradlew test -x :test --tests '*Test' --no-daemon --stacktrace"
          } else {
            bat ".\\gradlew.bat test -x :test --tests '*Test' --no-daemon --stacktrace"
          }
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'build/test-results/test/*.xml'
        }
      }
    }

    stage('BDD Tests (Cucumber)') {
      steps {
        script {
          if (isUnix()) {
            sh "./gradlew test --tests '*CucumberTestRunner' --no-daemon --stacktrace"
          } else {
            bat ".\\gradlew.bat test --tests '*CucumberTestRunner' --no-daemon --stacktrace"
          }
        }
      }
      post {
        always {
          // Publish Cucumber results to Allure
          allure includeProperties: false, jdk: '', results: [[path: 'build/allure-results']]
          
          // Also keep HTML report for backup
          script {
            if (fileExists('build/reports/cucumber/cucumber-report.html')) {
              publishHTML(target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'build/reports/cucumber',
                reportFiles: 'cucumber-report.html',
                reportName: 'Cucumber HTML Report',
                reportTitles: 'BDD Test Results'
              ])
            }
          }
        }
      }
    }

    stage('Package') {
      steps {
        script {
          if (isUnix()) {
            sh "./gradlew bootJar --no-daemon"
          } else {
            bat ".\\gradlew.bat bootJar --no-daemon"
          }
        }
      }
      post {
        success {
          archiveArtifacts artifacts: 'build/libs/*.jar', fingerprint: true, onlyIfSuccessful: true
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline completed successfully.'
    }
    failure {
      echo 'Pipeline failed.'
    }
    always {
      echo "Done."
    }
  }
}
