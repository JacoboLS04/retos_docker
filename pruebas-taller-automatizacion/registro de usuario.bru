meta {
  name: registro de usuario
  type: http
  seq: 1
}

post {
  url: {{base_url}}/usuarios
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Santiago",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
    - name: Código 201 - Usuario creado correctamente
      assert: response.status == 201
  
    - name: La respuesta contiene el email correcto
      assert: response.body.email == vars.email
  
    - name: Guardar user_id para próximas pruebas
      exec: vars.user_id = response.body.id
}

settings {
  encodeUrl: true
}
