{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Error Schema",
  "type": "object",
  "properties": {
    "code": {
      "type": ["integer", "string"],
      "description": "Código HTTP del error"
    },
    "message": {
      "type": "string",
      "description": "Descripción del error"
    },
    "details": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Detalles opcionales del error"
    }
  },
  "required": ["code", "message"],
  "additionalProperties": true
}
