{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Password Reset Schema",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "enum": ["reset_email_sent", "password_reset", "user_not_found", "invalid_token", "token_expired"],
      "description": "Mensaje que indica el estado de la operación"
    },
    "resetToken": {
      "type": ["string", "null"],
      "description": "Token temporal de restablecimiento (solo en reset request)"
    }
  },
  "required": ["message"],
  "additionalProperties": true
}
