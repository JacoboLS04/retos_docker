{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User List Schema",
  "type": "object",
  "properties": {
    "page": { "type": "integer" },
    "size": { "type": "integer" },
    "totalElements": { "type": "integer" },
    "totalPages": { "type": "integer" },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "nombre": { "type": "string" },
          "email": { "type": "string" },
          "estado": { "type": "string" }
        },
        "required": ["id", "nombre", "email"]
      }
    }
  },
  "required": ["page", "size", "data"],
  "additionalProperties": false
}
